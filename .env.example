# Ambiente local: dev ou prod
APP_ENV=dev
# API pública Warframe.market V2
WFM_BASE_URL=https://api.warframe.market
WFM_USER_AGENT="primo-data-platform/0.1.0 (+https://github.com/seu-usuario)"
WFM_LANGUAGE=en
WFM_REQUESTS_PER_SECOND=2
WFM_TIMEOUT_SECONDS=30
WFM_MAX_RETRIES=5

# Execução
SELECTED_PRODUCTS_FILE=config/selected_products.yml
OUTPUT_DIR=data/raw

# PostgreSQL (opcional no caminho Databricks)
POSTGRES_PORT=5432
POSTGRES_DB=primo_market
POSTGRES_USER=primo
POSTGRES_PASSWORD=primo_local_change_me
DATABASE_URL=postgresql+psycopg://primo:primo_local_change_me@localhost:5432/primo_market

# Databricks - preenchido no ambiente/CI, nunca versionar token
DATABRICKS_HOST=https://SEU_WORKSPACE.azuredatabricks.net
DATABRICKS_TOKEN=
